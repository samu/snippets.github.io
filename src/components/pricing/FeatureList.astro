---
import Icon from "../Icon.astro";
const { features } = Astro.props;
---

<ul class="plan-features">
  {features.map((feature) => <li>
    {feature.planned ? (
      <span class="planned-marker" aria-hidden="true">○</span>
    ) : (
      <Icon name="check" stroke-width="1.6" />
    )}<span
      >{feature.text}{feature.planned && <> <small>Planned</small></>}</span
    >
  </li>)}
</ul>

<style>
  .plan-features {
    display: flex;
    flex-direction: column;
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 19px 0 29px;
  }
  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 13px;
    line-height: 1.7;
  }
  .plan-features :global(svg) {
    color: #65849b;
    width: 16px;
    height: 16px;
    margin-top: 3px;
  }
  .plan-features small {
    font-size: 10px;
    color: var(--muted);
  }
  .planned-marker {
    color: var(--muted);
    width: 16px;
    flex-shrink: 0;
    text-align: center;
  }
  @media (max-width: 760px) {
    .plan-features {
      margin-bottom: 26px;
    }
  }
  .plan-features li {
    color: var(--ink);
    font-size: 14px;
  }
  .plan-features :global(svg) {
    color: var(--muted);
  }
  @media (max-width: 420px) {
    .plan-features li {
      font-size: 13px;
    }
  }
</style>
