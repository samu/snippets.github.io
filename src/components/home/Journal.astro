---
import Screenshot from "../Screenshot.astro";
---

<section
  id="journal"
  class="journal-section section-band"
  aria-labelledby="journal-heading"
  data-tone="orchid"
>
  <div class="section-shell">
    <header class="section-heading centered heading-group">
      <p class="eyebrow">Journaling & habit tracking</p>
      <h2
        id="journal-heading"
        class="phrase-reveal"
        aria-label="A little reflection. A little growth."
      >
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 0"
          >A little reflection.</span
        ><br />
        <span
          class="heading-phrase color-phrase"
          aria-hidden="true"
          style="--phrase-order: 1"
          >A little growth.</span
        >
      </h2>
      <p>Write about your day and track the habits you want to build.</p>
    </header>
    <figure class="wide-figure">
      <div class="screenshot-mat">
        <Screenshot
          class="theme-light product-image"
          src="landing-page/journal/light.png"
          alt="A daily journal alongside habit tracking calendars for exercise, going out, alcohol, meat, and other habits"
          loading="lazy"
        />
        <Screenshot
          class="theme-dark product-image"
          src="landing-page/journal/dark.png"
          alt="A daily journal alongside habit tracking calendars for exercise, going out, alcohol, meat, and other habits"
          loading="lazy"
        />
      </div>
    </figure>
  </div>
</section>

<style>
  .journal-section .wide-figure {
    max-width: 1020px;
  }
</style>
