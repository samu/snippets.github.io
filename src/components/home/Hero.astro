---
import Screenshot from "../Screenshot.astro";
---

<section
  class="hero section-shell"
  aria-labelledby="hero-heading"
  data-tone="sage"
>
  <h1
    id="hero-heading"
    class="phrase-reveal"
    aria-label="Note-taking that grows with you."
  >
    <span class="heading-phrase" aria-hidden="true" style="--phrase-order: 0"
      >Note-taking that</span
    ><br />
    <span
      class="heading-phrase color-phrase"
      aria-hidden="true"
      style="--phrase-order: 1"
      >grows with you.</span
    >
  </h1>
  <div class="hero-details">
    <p class="hero-description">
      A calm home for your notes, tasks, and everything in
      between.<br class="desktop-break" /> Simple to start. Room to make it
      yours.
    </p>
    <div class="hero-actions">
      <a class="button" href="#download">Get Snippets for free</a>
      <a class="text-link" href="#features"
        >Explore features
        <svg class="icon" aria-hidden="true">
          <use href="#arrow-right" />
        </svg></a
      >
    </div>
    <p class="availability">
      For macOS & Windows <span>·</span> iOS & Android in beta
    </p>

    <div class="hero-product">
      <div class="desktop-window">
        <Screenshot
          class="theme-light"
          src="landing-page/general-todos/light.png"
          alt="Snippets desktop app with a note on signal processing, a collection of notes, and attributes in the sidebar"
          fetchpriority="high"
          loading="eager"
        />
        <Screenshot
          class="theme-dark"
          src="landing-page/general-todos/dark.png"
          alt="Snippets desktop app with a note on signal processing, a collection of notes, and attributes in the sidebar"
          fetchpriority="high"
          loading="eager"
        />
      </div>
      <span class="product-caption"
        >One workspace. All the ways you think.</span
      >
    </div>
    <div class="principles" aria-label="Snippets principles">
      <span
        ><svg class="icon" aria-hidden="true"><use href="#check-icon" /></svg
        >Local first</span
      ><span
        ><svg class="icon" aria-hidden="true"><use href="#check-icon" /></svg
        >Your data, your choice</span
      ><span
        ><svg class="icon" aria-hidden="true"><use href="#check-icon" /></svg
        >Free to get started</span
      >
    </div>
  </div>
</section>
