---
import Screenshot from "../Screenshot.astro";
---

<section
  class="hero section-shell"
  aria-labelledby="hero-heading"
  data-tone="blue"
>
  <h1
    id="hero-heading"
    class="phrase-reveal"
    aria-label="A home for everything on your mind."
  >
    <span class="heading-phrase" aria-hidden="true" style="--phrase-order: 0"
      >A home for everything</span
    ><br />
    <span
      class="heading-phrase color-phrase"
      aria-hidden="true"
      style="--phrase-order: 1"
      >on your mind.</span
    >
  </h1>
  <div class="hero-details">
    <p class="hero-description">Write, plan, learn. Bring it all together.</p>
    <div class="hero-actions">
      <a class="button" href="#download">Get Snippets for free</a>
      <a class="text-link" href="#features"
        >Explore features
        <svg class="icon" aria-hidden="true">
          <use href="#arrow-right" />
        </svg></a
      >
    </div>
    <p class="availability">
      For macOS & Windows <span>·</span> iOS & Android in beta
    </p>

    <div class="hero-product">
      <div class="desktop-window">
        <Screenshot
          class="theme-light"
          src="landing-page/general-todos/light.png"
          alt="Snippets desktop app with a note on signal processing, a collection of notes, and attributes in the sidebar"
          fetchpriority="high"
          loading="eager"
        />
        <Screenshot
          class="theme-dark"
          src="landing-page/general-todos/dark.png"
          alt="Snippets desktop app with a note on signal processing, a collection of notes, and attributes in the sidebar"
          fetchpriority="high"
          loading="eager"
        />
      </div>
    </div>
    <div class="principles" aria-label="Snippets principles">
      <span
        ><svg class="icon" aria-hidden="true"><use href="#check-icon" /></svg
        >Local first</span
      ><span
        ><svg class="icon" aria-hidden="true"><use href="#check-icon" /></svg
        >Your data, your choice</span
      ><span
        ><svg class="icon" aria-hidden="true"><use href="#check-icon" /></svg
        >Free to get started</span
      >
    </div>
  </div>
</section>

<style>
  .hero {
    text-align: center;
    padding-top: var(--hero-top, 150px);
  }
  .hero h1 {
    font-size: clamp(52px, 5.6vw, 76px);
    font-weight: 550;
    line-height: 1.07;
    margin-top: 0;
    letter-spacing: -0.028em;
  }
  .hero-description {
    font-size: 18px;
    margin-top: 26px;
    color: var(--muted);
    letter-spacing: 0;
    line-height: 1.55;
    font-weight: 400;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 28px;
    margin-top: 30px;
  }
  .availability {
    color: var(--muted);
    font-size: 12px;
    margin-top: 18px;
  }
  .availability span {
    padding-inline: 7px;
  }
  .hero-product {
    position: relative;
    max-width: 950px;
    margin-inline: auto;
    margin-top: 64px;
    text-align: left;
  }
  .desktop-window {
    overflow: hidden;
    border-radius: 11px;
    background: white;
    border: 1px solid var(--screenshot-edge);
  }
  .desktop-window > :global(img) {
    width: 100%;
  }
  .principles {
    display: flex;
    justify-content: center;
    gap: 38px;
    margin-top: 38px;
    font-size: 12px;
    color: var(--muted);
  }
  .principles > span {
    display: flex;
    gap: 7px;
    align-items: center;
  }
  .principles .icon {
    width: 13px;
    height: 13px;
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .hero {
      padding-top: var(--hero-top, 130px);
    }
    .hero h1 {
      font-size: clamp(37px, 10vw, 60px);
      margin-top: 0;
    }
    .hero-description {
      font-size: 16px;
      max-width: 355px;
      margin-inline: auto;
      margin-top: 24px;
    }
    .hero-actions {
      gap: 18px;
      margin-top: 26px;
    }
    .hero-actions .button {
      font-size: 13px;
      padding: 11px 16px;
      min-height: 44px;
      gap: 8px;
    }
    .hero-actions .text-link {
      font-size: 13px;
      gap: 7px;
    }
    .availability {
      font-size: 11px;
    }
    .hero-product {
      margin-top: 45px;
    }
    .desktop-window {
      border-radius: 8px;
    }
    .principles {
      flex-wrap: wrap;
      gap: 10px 18px;
      font-size: 11px;
      margin-top: 28px;
    }
    .principles > span {
      gap: 3px;
    }
    .principles .icon {
      width: 11px;
      height: 11px;
    }
  }
  @media (max-width: 380px) {
    .hero h1 {
      margin-inline: -4px;
    }
    .hero-actions {
      flex-wrap: wrap;
      gap: 14px;
    }
  }
  :global(.home-page) .hero-description {
    color: var(--ink);
  }
  :global(.home-page) .hero-product {
    padding: 32px;
    border: 1px solid transparent;
  }
  :global(.home-page) .principles .icon {
    color: var(--muted);
  }
  @media (max-width: 700px) {
    :global(.home-page) .hero-product {
      padding: 14px;
    }
  }
</style>
