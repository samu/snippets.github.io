<section
  id="encryption"
  class="encryption-section section-shell"
  aria-labelledby="encryption-heading"
  data-tone="sage"
>
  <div class="encryption-feature">
    <div class="encryption-copy heading-group">
      <div class="encryption-kicker">
        <svg class="icon" aria-hidden="true"><use href="#lock-icon" /></svg
        ><span>Your notes. Your privacy.</span
        ><span class="encryption-pro">Pro</span>
      </div>
      <h2
        id="encryption-heading"
        class="phrase-reveal"
        aria-label="End-to-end encryption."
      >
        <span
          class="heading-phrase color-phrase"
          aria-hidden="true"
          style="--phrase-order: 0"
          >End-to-end</span
        ><br />
        <span
          class="heading-phrase color-phrase"
          aria-hidden="true"
          style="--phrase-order: 1"
          >encryption.</span
        >
      </h2>
      <p class="encryption-lead">Who can really read your notes?</p>
      <p class="encryption-detail">
        Most apps encrypt your notes in transit, but their providers can still
        read them. With end-to-end encryption enabled, Snippets encrypts notes
        on your device, so your provider cannot read them.
      </p>
      <div class="encryption-actions">
        <a class="button" href="/pricing/"
          >Explore Snippets Pro
          <svg class="icon" aria-hidden="true">
            <use href="#arrow-right" />
          </svg></a
        ><a class="text-link" href="/docs/sync/#end-to-end-encryption"
          >How it works
          <svg class="icon" aria-hidden="true">
            <use href="#arrow-right" />
          </svg></a
        >
      </div>
    </div>
    <figure
      class="encryption-visual"
      role="img"
      aria-label="Comparison: most apps encrypt notes in transit during sync, but their providers can still read them. Snippets also uses encryption in transit. With end-to-end encryption enabled, Snippets encrypts notes on your device before syncing. The provider receives encrypted data it cannot read."
    >
      <div class="privacy-comparison" aria-hidden="true">
        <div class="comparison-scene">
          <div class="comparison-row comparison-standard">
            <div class="comparison-row-heading">
              <strong>Most apps</strong
              ><span>Without end-to-end encryption</span>
            </div>
            <div class="comparison-flow">
              <div class="comparison-endpoint">
                <div class="encryption-location">
                  <svg class="icon"><use href="#device-icon" /></svg
                  ><span>Your device</span>
                </div>
                <div class="comparison-note">
                  <span>My next idea</span><i></i><i></i>
                </div>
              </div>
              <div class="comparison-transfer">
                <span class="comparison-track"
                  ><svg class="icon"><use href="#lock-icon" /></svg></span
                ><span class="comparison-transfer-label"
                  >Encryption<br />in transit</span
                >
              </div>
              <div class="comparison-endpoint">
                <div class="encryption-location">
                  <svg class="icon"><use href="#server-icon" /></svg
                  ><span>Provider’s server</span>
                </div>
                <div class="comparison-note comparison-readable">
                  <span class="comparison-access-mark"
                    ><svg class="icon"><use href="#eye-icon" /></svg></span
                  ><span>My next idea</span><i></i><i></i>
                </div>
              </div>
            </div>
            <p class="comparison-outcome">
              <span>Your provider can read your notes.</span>
            </p>
          </div>
        </div>
        <div class="comparison-scene">
          <div class="comparison-row comparison-private">
            <div class="comparison-row-heading">
              <strong>Snippets</strong><span>With end-to-end encryption</span>
            </div>
            <div class="comparison-flow">
              <div class="comparison-endpoint">
                <div class="encryption-location">
                  <svg class="icon"><use href="#device-icon" /></svg
                  ><span>Your device</span>
                </div>
                <div class="comparison-note">
                  <span>My next idea</span><i></i><i></i>
                </div>
              </div>
              <div class="comparison-transfer">
                <span class="comparison-track"
                  ><svg class="icon"><use href="#lock-icon" /></svg></span
                ><span class="comparison-transfer-label"
                  >Encryption<br />in transit</span
                >
              </div>
              <div class="comparison-endpoint">
                <div class="encryption-location">
                  <svg class="icon"><use href="#server-icon" /></svg
                  ><span>Provider’s server</span>
                </div>
                <div class="comparison-note comparison-cipher">
                  <span class="comparison-access-mark"
                    ><svg class="icon">
                      <use href="#shield-check-icon" />
                    </svg></span
                  ><span>Encrypted data</span
                  ><code
                    ><span style="--chunk: 0">01101001</span>
                    <span style="--chunk: 1">1011</span
                    ><br /><span style="--chunk: 2">10010110</span>
                    <span style="--chunk: 3">0100</span></code
                  >
                </div>
              </div>
            </div>
            <p class="comparison-outcome">
              <span>Your provider cannot read your notes.</span>
            </p>
          </div>
          <p class="comparison-explainer">
            End-to-end encrypted. Only readable on your devices.
          </p>
        </div>
      </div>
    </figure>
  </div>
</section>
