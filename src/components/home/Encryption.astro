---
import SectionLight from "./SectionLight.astro";
---

<section
  id="encryption"
  class="encryption-section section-shell"
  data-light-scene
  aria-labelledby="encryption-heading"
  data-tone="sage"
>
  <SectionLight variant="pearl" area="inset" side="left" />
  <div class="encryption-feature">
    <div class="encryption-copy heading-group">
      <div class="encryption-kicker">
        <svg class="icon" aria-hidden="true"><use href="#lock-icon" /></svg
        ><span>Your notes. Your privacy.</span
        ><span class="encryption-pro">Pro</span>
      </div>
      <h2
        id="encryption-heading"
        class="phrase-reveal"
        aria-label="End-to-end encryption."
      >
        <span
          class="heading-phrase color-phrase"
          aria-hidden="true"
          style="--phrase-order: 0"
          >End-to-end</span
        ><br />
        <span
          class="heading-phrase color-phrase"
          aria-hidden="true"
          style="--phrase-order: 1"
          >encryption.</span
        >
      </h2>
      <p class="encryption-lead">Who can really read your notes?</p>
      <p class="encryption-detail">
        Most apps encrypt your notes in transit, but their providers can still
        read them. With end-to-end encryption enabled, Snippets encrypts notes
        on your device, so your provider cannot read them.
      </p>
      <div class="encryption-actions">
        <a class="button" href="/pricing/"
          >Explore Snippets Pro
          <svg class="icon" aria-hidden="true">
            <use href="#arrow-right" />
          </svg></a
        ><a class="text-link" href="/docs/sync/#end-to-end-encryption"
          >How it works
          <svg class="icon" aria-hidden="true">
            <use href="#arrow-right" />
          </svg></a
        >
      </div>
    </div>
    <figure
      class="encryption-visual"
      role="img"
      aria-label="Comparison: most apps encrypt notes in transit during sync, but their providers can still read them. Snippets also uses encryption in transit. With end-to-end encryption enabled, Snippets encrypts notes on your device before syncing. The provider receives encrypted data it cannot read."
    >
      <div class="privacy-comparison" aria-hidden="true">
        <div class="comparison-scene">
          <div class="comparison-row comparison-standard">
            <div class="comparison-row-heading">
              <strong>Most apps</strong
              ><span>Without end-to-end encryption</span>
            </div>
            <div class="comparison-flow">
              <div class="comparison-endpoint">
                <div class="encryption-location">
                  <svg class="icon"><use href="#device-icon" /></svg
                  ><span>Your device</span>
                </div>
                <div class="comparison-note">
                  <span>My next idea</span><i></i><i></i>
                </div>
              </div>
              <div class="comparison-transfer">
                <span class="comparison-track"
                  ><svg class="icon"><use href="#lock-icon" /></svg></span
                ><span class="comparison-transfer-label"
                  >Encryption<br />in transit</span
                >
              </div>
              <div class="comparison-endpoint">
                <div class="encryption-location">
                  <svg class="icon"><use href="#server-icon" /></svg
                  ><span>Provider’s server</span>
                </div>
                <div class="comparison-note comparison-readable">
                  <span class="comparison-access-mark"
                    ><svg class="icon"><use href="#eye-icon" /></svg></span
                  ><span>My next idea</span><i></i><i></i>
                </div>
              </div>
            </div>
            <p class="comparison-outcome">
              <span>Your provider can read your notes.</span>
            </p>
          </div>
        </div>
        <div class="comparison-scene">
          <div class="comparison-row comparison-private">
            <div class="comparison-row-heading">
              <strong>Snippets</strong><span>With end-to-end encryption</span>
            </div>
            <div class="comparison-flow">
              <div class="comparison-endpoint">
                <div class="encryption-location">
                  <svg class="icon"><use href="#device-icon" /></svg
                  ><span>Your device</span>
                </div>
                <div class="comparison-note">
                  <span>My next idea</span><i></i><i></i>
                </div>
              </div>
              <div class="comparison-transfer">
                <span class="comparison-track"
                  ><svg class="icon"><use href="#lock-icon" /></svg></span
                ><span class="comparison-transfer-label"
                  >Encryption<br />in transit</span
                >
              </div>
              <div class="comparison-endpoint">
                <div class="encryption-location">
                  <svg class="icon"><use href="#server-icon" /></svg
                  ><span>Provider’s server</span>
                </div>
                <div class="comparison-note comparison-cipher">
                  <span class="comparison-access-mark"
                    ><svg class="icon">
                      <use href="#shield-check-icon" />
                    </svg></span
                  ><span>Encrypted data</span
                  ><code
                    ><span style="--chunk: 0">01101001</span>
                    <span style="--chunk: 1">1011</span
                    ><br /><span style="--chunk: 2">10010110</span>
                    <span style="--chunk: 3">0100</span></code
                  >
                </div>
              </div>
            </div>
            <p class="comparison-outcome">
              <span>Your provider cannot read your notes.</span>
            </p>
          </div>
          <p class="comparison-explainer">
            End-to-end encrypted. Only readable on your devices.
          </p>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .encryption-section {
    display: flex;
    align-items: center;
    gap: 32px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 40px 0;
    margin-block: 72px 130px;
  }
  .privacy-seal {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    color: var(--ink);
  }
  .privacy-seal .icon {
    width: 30px;
    height: 30px;
    stroke-width: 1.3;
  }
  .encryption-section .eyebrow {
    color: var(--muted);
    font-size: 13px;
  }
  .encryption-section h2 {
    font-size: 28px;
    margin-block: 8px 12px;
    letter-spacing: -0.02em;
  }
  .encryption-section p:not(.eyebrow) {
    font-size: 15px;
    color: var(--muted);
    max-width: 730px;
  }
  @media (max-width: 700px) {
    .encryption-section {
      padding: 28px 0;
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
      margin-block: 45px 75px;
    }
    .privacy-seal {
      width: 32px;
      height: 32px;
    }
    .privacy-seal .icon {
      width: 23px;
      height: 23px;
    }
    .encryption-section h2 {
      font-size: 25px;
    }
    .encryption-section p:not(.eyebrow) {
      font-size: 15px;
    }
  }
  :global(.home-page) .privacy-seal {
    background: var(--accent-paper);
    color: var(--accent);
    border-radius: 16px;
  }
  :global(.home-page) .encryption-section {
    display: block;
    padding: clamp(30px, 4vw, 48px);
    margin-block: 86px 110px;
    scroll-margin-top: var(--reveal-text-distance, 0px);
    border: 1px solid var(--border);
    border-radius: 20px;
    background: linear-gradient(120deg, var(--paper), var(--panel-strong));
    box-shadow: 0 24px 56px -44px oklch(0.25 0.0125 80 / 0.2);
  }
  .encryption-feature {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    align-items: center;
    gap: clamp(28px, 3.5vw, 44px);
  }
  .encryption-copy {
    min-width: 0;
  }
  .encryption-kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--ink);
    font-size: 11px;
    font-weight: 600;
  }
  .encryption-kicker > .icon {
    width: 15px;
    height: 15px;
    color: var(--accent);
  }
  .encryption-pro {
    padding: 3px 7px;
    border: 1px solid var(--accent-border);
    border-radius: 5px;
    font-size: 9px;
    line-height: 1.2;
    color: var(--accent);
    background: var(--white);
  }
  :global(.home-page) .encryption-section h2 {
    margin-block: 19px 20px;
    font-size: clamp(38px, 4vw, 50px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 700;
  }
  .encryption-copy h2 > span {
    color: var(--heading);
  }
  .encryption-copy h2 > .color-phrase {
    color: var(--section-accent);
  }
  :global(.home-page) .encryption-section .encryption-lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
  }
  :global(.home-page) .encryption-section .encryption-detail {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.75;
    color: var(--muted);
    max-width: 360px;
  }
  .encryption-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 24px;
  }
  .encryption-actions .button {
    font-size: 12px;
    padding-inline: 16px;
  }
  .encryption-actions .text-link {
    font-size: 12px;
  }
  .encryption-visual {
    min-width: 0;
  }
  .privacy-comparison {
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
  }
  .comparison-row {
    position: relative;
    padding: 18px;
    border: 1px solid var(--comparison-border);
    border-radius: 12px;
    background: var(--white);
  }
  .comparison-scene + .comparison-scene {
    margin-top: 16px;
  }
  .comparison-standard {
    --comparison-tone: oklch(0.523126 0.140563 32.344);
    --comparison-accent: oklch(0.7 0.08 32);
    --comparison-border: color-mix(
      in oklch,
      var(--comparison-tone) 24%,
      var(--white)
    );
    --comparison-surface: oklch(0.936087 0.02625 32.237);
  }
  .comparison-private {
    --comparison-tone: oklch(0.495966 0.100488 151.884);
    --comparison-accent: oklch(0.7 0.07 152);
    --comparison-border: color-mix(
      in oklch,
      var(--comparison-tone) 24%,
      var(--white)
    );
    --comparison-surface: oklch(0.942657 0.024187 151.178);
    box-shadow: 0 10px 24px -20px oklch(0.25 0.0125 80 / 0.2);
  }
  .comparison-row-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-bottom: 15px;
    line-height: 1.5;
  }
  .comparison-row-heading strong {
    font-size: 14px;
    font-weight: 600;
    color: var(--heading);
  }
  .comparison-row-heading > span {
    padding: 3px 7px;
    border-radius: 4px;
    background: var(--comparison-surface);
    color: var(--comparison-tone);
    font-size: 10px;
  }
  .comparison-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 88px minmax(0, 1fr);
    align-items: start;
  }
  .comparison-endpoint {
    min-width: 0;
  }
  .encryption-location {
    display: flex;
    align-items: center;
    gap: 5px;
    min-height: 20px;
    margin-bottom: 9px;
    color: var(--ink);
    font-size: 11px;
    line-height: 1.4;
  }
  .encryption-location .icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .comparison-note {
    position: relative;
    height: 82px;
    padding: 13px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--panel);
  }
  .comparison-note > span:not(.comparison-access-mark) {
    display: block;
    color: var(--heading);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.015em;
  }
  .comparison-note i {
    display: block;
    width: 86%;
    height: 3px;
    margin-top: 12px;
    border-radius: 3px;
    background: var(--border);
  }
  .comparison-note i + i {
    width: 61%;
    margin-top: 5px;
  }
  .comparison-readable,
  .comparison-cipher {
    background: var(--comparison-surface);
    border-color: var(--comparison-accent);
    box-shadow: 0 4px 10px -8px var(--comparison-tone);
  }
  .comparison-readable > span:not(.comparison-access-mark) {
    color: var(--comparison-tone);
  }
  .comparison-readable i {
    background: color-mix(in oklch, var(--comparison-accent) 28%, var(--white));
  }
  .comparison-cipher > span:not(.comparison-access-mark) {
    color: var(--comparison-tone);
    font-size: 11px;
    font-weight: 400;
  }
  .comparison-cipher code {
    display: block;
    margin-top: 8px;
    color: var(--comparison-tone);
    font:
      11px/1.6 ui-monospace,
      SFMono-Regular,
      Consolas,
      monospace;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .comparison-access-mark {
    position: absolute;
    top: -10px;
    right: 9px;
    display: grid;
    place-items: center;
    width: 25px;
    height: 25px;
    border: 1px solid var(--comparison-accent);
    border-radius: 50%;
    background: var(--white);
    color: var(--comparison-tone);
  }
  .comparison-access-mark .icon {
    width: 15px;
    height: 15px;
    stroke-width: 1.7;
  }
  .comparison-transfer {
    margin-top: 53px;
    display: grid;
    justify-items: center;
    gap: 5px;
  }
  .comparison-track {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 23px;
  }
  .comparison-track::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 11px;
    border-top: 1px dotted var(--screenshot-edge);
  }
  .comparison-track .icon {
    position: relative;
    width: 23px;
    height: 23px;
    padding: 5px;
    border: 1px solid var(--screenshot-edge);
    border-radius: 50%;
    background: var(--white);
    color: var(--muted);
  }
  .comparison-transfer-label {
    max-width: 78px;
    color: var(--ink);
    font-size: 9px;
    line-height: 1.4;
    text-align: center;
  }
  :global(.home-page) .encryption-section .comparison-outcome {
    margin-top: 15px;
    padding-top: 12px;
    border-top: 1px solid var(--comparison-border);
    color: var(--comparison-tone);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }
  :global(.home-page) .encryption-section .comparison-explainer {
    margin: 12px 3px 0;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.7;
  }
  @supports (animation-timeline: view(block)) and
    (animation-range: entry 18svh entry 19svh) {
    @media screen and (prefers-reduced-motion: no-preference) {
      .comparison-scene {
        container-name: privacy-diagram;
        animation: privacy-diagram-entry auto step-end both;
        animation-timeline: view(block);
        animation-range: entry 18svh entry calc(18svh + 1px);
      }
      .comparison-row,
      .comparison-row-heading > *,
      .encryption-location > *,
      .comparison-note,
      .comparison-note > span,
      .comparison-track .icon,
      .comparison-transfer-label,
      .comparison-outcome > span,
      .comparison-explainer {
        --diagram-delay: 0ms;
        --diagram-offset: 12px;
        --diagram-scale: 1;
        opacity: 1;
        transform: none;
        transition:
          opacity 440ms ease-out var(--diagram-delay),
          transform 620ms cubic-bezier(0.22, 0.65, 0.32, 1) var(--diagram-delay);
      }
      .comparison-row {
        --diagram-offset: 22px;
        --diagram-scale: 0.975;
      }
      .comparison-row-heading strong {
        --diagram-delay: 100ms;
      }
      .comparison-row-heading > span {
        --diagram-delay: 220ms;
        --diagram-scale: 0.94;
      }
      .encryption-location > .icon {
        --diagram-delay: 280ms;
        --diagram-scale: 0.65;
      }
      .encryption-location > span {
        --diagram-delay: 350ms;
      }
      .comparison-note {
        --diagram-delay: 420ms;
        --diagram-scale: 0.93;
      }
      .comparison-note > span:not(.comparison-access-mark) {
        --diagram-delay: 540ms;
        --diagram-offset: 6px;
      }
      .comparison-note i {
        clip-path: inset(0);
        transition: clip-path 400ms cubic-bezier(0.22, 0.65, 0.32, 1) 620ms;
      }
      .comparison-note i + i {
        transition-delay: 740ms;
      }
      .comparison-track::before {
        clip-path: inset(0);
        transition: clip-path 620ms cubic-bezier(0.22, 0.65, 0.32, 1) 800ms;
      }
      .comparison-track .icon {
        --diagram-delay: 880ms;
        --diagram-scale: 0.5;
        --diagram-offset: 0px;
        z-index: 1;
      }
      .comparison-transfer-label {
        --diagram-delay: 1000ms;
        --diagram-offset: 6px;
      }
      .comparison-track::after {
        content: "";
        position: absolute;
        top: 9px;
        left: 0;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
        opacity: 0;
      }
      .comparison-endpoint:last-child .encryption-location > .icon {
        --diagram-delay: 1040ms;
      }
      .comparison-endpoint:last-child .encryption-location > span {
        --diagram-delay: 1120ms;
      }
      .comparison-endpoint:last-child .comparison-note {
        --diagram-delay: 1200ms;
      }
      .comparison-endpoint:last-child
        .comparison-note
        > span:not(.comparison-access-mark) {
        --diagram-delay: 1340ms;
      }
      .comparison-endpoint:last-child .comparison-note i {
        transition-delay: 1440ms;
      }
      .comparison-endpoint:last-child .comparison-note i + i {
        transition-delay: 1560ms;
      }
      .comparison-cipher code > span {
        display: inline-block;
        clip-path: inset(0);
        opacity: 1;
        transition:
          clip-path 280ms steps(8, end) calc(1420ms + var(--chunk) * 90ms),
          opacity 160ms ease-out calc(1420ms + var(--chunk) * 90ms);
      }
      .comparison-note > .comparison-access-mark {
        --diagram-delay: 1720ms;
        --diagram-offset: 0px;
        --diagram-scale: 0.35;
        transition-timing-function: ease-out, cubic-bezier(0.2, 1.5, 0.35, 1);
      }
      :global(.home-page) .encryption-section .comparison-outcome {
        position: relative;
        border-top-color: transparent;
      }
      .comparison-outcome::before {
        content: "";
        position: absolute;
        top: -1px;
        inset-inline: 0;
        height: 1px;
        background: var(--comparison-border);
        clip-path: inset(0);
        transition: clip-path 500ms ease-out 1300ms;
      }
      .comparison-outcome > span {
        display: inline-block;
        --diagram-delay: 1380ms;
        --diagram-offset: 8px;
      }
      .comparison-scene .comparison-explainer {
        --diagram-delay: 2000ms;
        --diagram-offset: 6px;
      }
      @container privacy-diagram style(--diagram-state: visible) {
        .comparison-track::after {
          animation: privacy-sync-packet 850ms ease-in-out 1100ms both;
        }
      }
      @container privacy-diagram style(--diagram-state: waiting) {
        .comparison-row,
        .comparison-row-heading > *,
        .encryption-location > *,
        .comparison-note,
        .comparison-note > span,
        .comparison-track .icon,
        .comparison-transfer-label,
        .comparison-outcome > span,
        .comparison-explainer {
          opacity: 0;
          transform: translateY(var(--diagram-offset))
            scale(var(--diagram-scale));
          /* A quick, unified exit instead of running the explanation backwards. */
          transition-duration: 240ms;
          transition-delay: 0ms;
        }
        .comparison-note i,
        .comparison-cipher code > span,
        .comparison-track::before,
        .comparison-outcome::before {
          clip-path: inset(0 100% 0 0);
          transition-duration: 240ms;
          transition-delay: 0ms;
        }
        .comparison-cipher code > span {
          opacity: 0;
        }
      }
      .encryption-lead,
      .encryption-detail,
      .encryption-actions > a {
        --copy-delay: 220ms;
        opacity: 1;
        translate: none;
        transition:
          opacity 500ms ease-out var(--copy-delay),
          translate 620ms ease-out var(--copy-delay);
      }
      .encryption-detail {
        --copy-delay: 360ms;
      }
      .encryption-actions > a {
        --copy-delay: 500ms;
      }
      .encryption-actions > a + a {
        --copy-delay: 620ms;
      }
      @container phrase-heading style(--heading-state: waiting) {
        .encryption-lead,
        .encryption-detail,
        .encryption-actions > a {
          opacity: 0;
          translate: 0 16px;
          transition-duration: 240ms;
          transition-delay: 0ms;
        }
      }
      .encryption-copy:focus-within
        :is(.encryption-lead, .encryption-detail, .encryption-actions > a) {
        opacity: 1;
        translate: none;
        transition: none;
      }
    }
  }
  @keyframes privacy-diagram-entry {
    from {
      --diagram-state: waiting;
    }
    to {
      --diagram-state: visible;
    }
  }
  @keyframes privacy-sync-packet {
    0% {
      left: 0;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 5px);
      opacity: 0;
    }
  }

  @media (max-width: 1000px) {
    :global(.home-page) .encryption-section {
      padding: 32px;
    }
    .encryption-feature {
      gap: 28px;
    }
    :global(.home-page) .encryption-section h2 {
      font-size: 40px;
    }
    .comparison-row {
      padding: 16px;
    }
    .comparison-flow {
      grid-template-columns: minmax(0, 1fr) 78px minmax(0, 1fr);
    }
  }
  @media (max-width: 860px) {
    :global(.home-page) .encryption-section {
      padding: 32px;
      margin-block: 60px 75px;
    }
    .encryption-feature {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .encryption-copy {
      width: 100%;
      max-width: 520px;
      margin-inline: auto;
    }
    :global(.home-page) .encryption-section .encryption-detail {
      max-width: 440px;
    }
  }
  @media (max-width: 480px) {
    :global(.home-page) .encryption-section {
      padding: 27px 20px;
      border-radius: 16px;
    }
    :global(.home-page) .encryption-section h2 {
      font-size: 35px;
    }
    .comparison-row {
      padding: 14px 10px;
    }
    .comparison-row-heading {
      display: grid;
      justify-items: start;
      gap: 5px;
      margin-bottom: 13px;
    }
    .comparison-flow {
      grid-template-columns: minmax(0, 1fr) 56px minmax(0, 1fr);
    }
