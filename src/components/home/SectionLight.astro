---
interface Props {
  variant?: "porcelain" | "linen" | "mist" | "lilac" | "pearl";
  area?: "heading" | "section" | "hero" | "inset";
  side?: "center" | "left" | "right";
}
const {
  variant = "porcelain",
  area = "heading",
  side = "center",
} = Astro.props;
---

<div
  class:list={[
    "section-light",
    `light-${variant}`,
    `area-${area}`,
    `side-${side}`,
  ]}
  aria-hidden="true"
></div>

<style>
  /* Each instance reads the nearest scene's timeline, never the whole page. */
  :global([data-light-scene]) {
    position: relative;
    isolation: isolate;
    view-timeline-name: --section-light;
    view-timeline-axis: block;
  }
  .section-light {
    --ivory: light-dark(rgb(226 205 170 / 0.38), rgb(190 168 137 / 0.135));
    --lavender: light-dark(rgb(188 178 206 / 0.27), rgb(181 161 211 / 0.12));
    --grey: light-dark(rgb(173 184 197 / 0.175), rgb(156 174 192 / 0.067));
    --wash-one: var(--ivory);
    --wash-two: var(--lavender);
    --wash-three: var(--grey);
    --angle-one: 116deg;
    --angle-two: 70deg;
    --angle-three: 145deg;
    --start-x: -48px;
    --start-y: -26px;
    --end-x: 48px;
    --end-y: 48px;
    --strength: 1;
    --light-center: 50%;
    --light-radius: 46%;
    position: absolute;
    inset: -80px 0 -100px;
    z-index: -1;
    overflow: clip;
    pointer-events: none;
    /* Keep the entire falloff inside the scene, including left/right variants.
       Only the color layer moves: this transparent perimeter stays fixed. */
    mask-image: radial-gradient(
      ellipse var(--light-radius) 46% at var(--light-center) 50%,
      #000 0%,
      rgb(0 0 0 / 0.95) 22%,
      rgb(0 0 0 / 0.6) 48%,
      rgb(0 0 0 / 0.16) 72%,
      transparent 92%
    );
  }
  .section-light::before {
    content: "";
    position: absolute;
    inset: -60px;
    background:
      linear-gradient(
        var(--angle-one),
        transparent 12%,
        var(--wash-one) 34%,
        transparent 61%
      ),
      linear-gradient(
        var(--angle-two),
        transparent 38%,
        var(--wash-two) 64%,
        transparent 89%
      ),
      linear-gradient(
        var(--angle-three),
        transparent 20%,
        var(--wash-three) 48%,
        transparent 76%
      );
    filter: blur(38px);
    opacity: calc(0.8 * var(--strength));
  }
  .light-linen {
    --wash-two: light-dark(rgb(205 183 174 / 0.175), rgb(196 170 160 / 0.08));
    --wash-three: light-dark(rgb(188 178 206 / 0.135), rgb(181 161 211 / 0.054));
    --angle-one: 108deg;
    --angle-two: 32deg;
    --angle-three: 155deg;
    --start-x: 34px;
    --start-y: -20px;
    --end-x: -38px;
    --end-y: 40px;
  }
  .light-mist {
    --wash-one: light-dark(rgb(166 184 202 / 0.27), rgb(154 178 202 / 0.12));
    --wash-two: light-dark(rgb(226 205 170 / 0.24), rgb(190 168 137 / 0.095));
    --wash-three: var(--lavender);
    --angle-one: 64deg;
    --angle-two: 130deg;
    --angle-three: 150deg;
    --start-x: -32px;
    --start-y: -38px;
    --end-x: 42px;
    --end-y: 30px;
  }
  .light-lilac {
    --wash-one: var(--lavender);
    --wash-two: var(--ivory);
    --angle-one: 135deg;
    --angle-two: 54deg;
    --angle-three: 105deg;
    --start-x: 42px;
    --start-y: -28px;
    --end-x: -40px;
    --end-y: 48px;
  }
  .light-pearl {
    --wash-one: light-dark(rgb(173 184 197 / 0.27), rgb(156 174 192 / 0.11));
    --wash-two: var(--ivory);
    --wash-three: var(--lavender);
    --angle-one: 145deg;
    --angle-two: 25deg;
    --angle-three: 72deg;
    --strength: 0.75;
    --start-x: 24px;
    --end-x: -32px;
  }
  .area-section {
    inset: 0;
  }
  .area-hero {
    inset: 0 0 auto;
    height: min(850px, 100%);
  }
  .area-inset {
    inset: 0;
    border-radius: inherit;
  }
  .side-left {
    --light-center: 36%;
    --light-radius: 32%;
  }
  .side-right {
    --light-center: 64%;
    --light-radius: 32%;
  }

  @supports (animation-timeline: view(block)) {
    @media (prefers-reduced-motion: no-preference) {
      .section-light::before {
        animation: section-light-drift linear both;
        animation-timeline: --section-light;
        animation-range: entry 0% exit 100%;
      }
    }
  }
  @keyframes section-light-drift {
    0% {
      transform: translate(var(--start-x), var(--start-y));
      opacity: calc(0.25 * var(--strength));
    }
    40% {
      opacity: calc(0.85 * var(--strength));
    }
    70% {
      opacity: calc(0.75 * var(--strength));
    }
    100% {
      transform: translate(var(--end-x), var(--end-y));
      opacity: calc(0.2 * var(--strength));
    }
  }
  @media (max-width: 700px) {
    .area-heading {
      inset: -48px 0 -64px;
    }
    .area-hero {
      height: min(700px, 100%);
    }
    .side-left {
      --light-center: 44%;
      --light-radius: 40%;
    }
    .side-right {
      --light-center: 56%;
      --light-radius: 40%;
    }
  }
</style>
