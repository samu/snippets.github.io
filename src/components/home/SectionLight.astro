---
interface Props {
  variant?: "porcelain" | "linen" | "mist" | "lilac" | "pearl";
  area?: "heading" | "section" | "hero" | "inset" | "copy";
  coverage?: "focused" | "wide";
}
const {
  variant = "porcelain",
  area = "heading",
  coverage = "focused",
} = Astro.props;
---

<div
  class:list={[
    "section-light",
    `light-${variant}`,
    `area-${area}`,
    `coverage-${coverage}`,
  ]}
  aria-hidden="true"
></div>

<style>
  /* Each wash stays contained behind its section's content. */
  :global([data-light-scene]) {
    position: relative;
    isolation: isolate;
  }
  .section-light {
    /* Dark mode uses deeper pigments: color without a pale, luminous veil. */
    --ivory: light-dark(rgb(226 205 170 / 0.48), rgb(156 84 55 / 0.056));
    --lavender: light-dark(rgb(188 178 206 / 0.36), rgb(105 65 166 / 0.056));
    --grey: light-dark(rgb(173 184 197 / 0.24), rgb(62 101 132 / 0.031));
    --wash-one: var(--ivory);
    --wash-two: var(--lavender);
    --wash-three: var(--grey);
    --angle-one: 116deg;
    --angle-two: 70deg;
    --angle-three: 145deg;
    --strength: 1;
    position: absolute;
    inset: -150px 0 -170px;
    z-index: -1;
    overflow: clip;
    pointer-events: none;
    /* Independent, gradual edge fades avoid an oval spotlight around the text.
       The wash still reaches full transparency before its bounds. */
    mask-image:
      linear-gradient(
        90deg,
        transparent 1%,
        rgb(0 0 0 / 0.12) 7%,
        rgb(0 0 0 / 0.4) 15%,
        rgb(0 0 0 / 0.72) 25%,
        rgb(0 0 0 / 0.94) 38%,
        #000 48% 52%,
        rgb(0 0 0 / 0.94) 62%,
        rgb(0 0 0 / 0.72) 75%,
        rgb(0 0 0 / 0.4) 85%,
        rgb(0 0 0 / 0.12) 93%,
        transparent 99%
      ),
      linear-gradient(
        transparent 1%,
        rgb(0 0 0 / 0.12) 7%,
        rgb(0 0 0 / 0.4) 15%,
        rgb(0 0 0 / 0.72) 25%,
        rgb(0 0 0 / 0.94) 38%,
        #000 48% 52%,
        rgb(0 0 0 / 0.94) 62%,
        rgb(0 0 0 / 0.72) 75%,
        rgb(0 0 0 / 0.4) 85%,
        rgb(0 0 0 / 0.12) 93%,
        transparent 99%
      );
    mask-composite: intersect;
  }
  .section-light::before {
    content: "";
    position: absolute;
    inset: -100px;
    background:
      linear-gradient(
        var(--angle-one),
        transparent 12%,
        var(--wash-one) 34%,
        transparent 61%
      ),
      linear-gradient(
        var(--angle-two),
        transparent 38%,
        var(--wash-two) 64%,
        transparent 89%
      ),
      linear-gradient(
        var(--angle-three),
        transparent 20%,
        var(--wash-three) 48%,
        transparent 76%
      );
    filter: blur(72px);
    opacity: calc(0.8 * var(--strength));
  }
  .light-linen {
    --wash-two: light-dark(rgb(205 183 174 / 0.23), rgb(158 68 89 / 0.0375));
    --wash-three: light-dark(rgb(188 178 206 / 0.18), rgb(105 65 166 / 0.025));
    --angle-one: 108deg;
    --angle-two: 32deg;
    --angle-three: 155deg;
  }
  .light-mist {
    --wash-one: light-dark(rgb(166 184 202 / 0.36), rgb(58 93 150 / 0.05));
    --wash-two: light-dark(rgb(226 205 170 / 0.32), rgb(144 95 62 / 0.0375));
    --wash-three: var(--lavender);
    --angle-one: 64deg;
    --angle-two: 130deg;
    --angle-three: 150deg;
  }
  .light-lilac {
    --wash-one: var(--lavender);
    --wash-two: var(--ivory);
    --angle-one: 135deg;
    --angle-two: 54deg;
    --angle-three: 105deg;
  }
  .light-pearl {
    --wash-one: light-dark(rgb(173 184 197 / 0.36), rgb(61 109 131 / 0.044));
    --wash-two: var(--ivory);
    --wash-three: var(--lavender);
    --angle-one: 145deg;
    --angle-two: 25deg;
    --angle-three: 72deg;
    --strength: 0.8;
  }
  .area-section {
    inset: 0;
  }
  .area-hero {
    inset: 0 0 auto;
    height: min(600px, 100%);
  }
  .area-inset {
    inset: 0;
    border-radius: inherit;
  }
  .area-copy {
    /* Center the pool on the copy, with a soft falloff beyond the column. */
    --copy-bleed: clamp(32px, calc((100vw - 1160px) / 2), 180px);
    inset: -160px calc(-1 * var(--copy-bleed));
  }

  @media (min-width: 701px) {
    /* Broad layouts also spread the color bands across their text columns. */
    .coverage-wide::before {
      background:
        linear-gradient(
          var(--angle-one),
          transparent 0%,
          var(--wash-one) 24%,
          transparent 82%
        ),
        linear-gradient(
          var(--angle-two),
          transparent 14%,
          var(--wash-two) 68%,
          transparent 100%
        ),
        linear-gradient(
          var(--angle-three),
          transparent 0%,
          var(--wash-three) 48%,
          transparent 100%
        );
    }
  }

  @supports (animation-timeline: view(block)) and
    (timeline-scope: --light-heading) {
    @media (prefers-reduced-motion: no-preference) {
      :global([data-light-scene]) {
        timeline-scope: --light-heading;
      }
      :global([data-light-scene] .phrase-reveal) {
        view-timeline-name: --light-heading;
        view-timeline-axis: block;
      }
      .section-light::before {
        /* Every text pool follows the same heading entrance, without a delay. */
        animation: text-light-fade ease-in-out both;
        animation-timeline: --light-heading;
        animation-range: entry var(--content-full, 33svh) entry
          calc(var(--content-full, 33svh) + 17svh);
      }
    }
  }
  @keyframes text-light-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: calc(0.85 * var(--strength));
    }
  }
  @media (max-width: 700px) {
    .area-copy {
      inset: -105px -22px;
    }
    .area-heading {
      inset: -110px 0 -125px;
    }
    .area-hero {
      height: min(560px, 100%);
    }
    .section-light::before {
      filter: blur(52px);
    }
  }
</style>
