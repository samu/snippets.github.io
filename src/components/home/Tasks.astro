---
import Screenshot from "../Screenshot.astro";
---

<section
  id="tasks"
  class="tasks-section section-band"
  aria-labelledby="tasks-heading"
  data-tone="sage"
>
  <div class="section-shell">
    <header class="section-heading centered heading-group">
      <p class="eyebrow">Task management</p>
      <h2
        id="tasks-heading"
        class="phrase-reveal"
        aria-label="From a thought. To a thing done."
      >
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 0"
          >From a thought.</span
        ><br />
        <span
          class="heading-phrase color-phrase"
          aria-hidden="true"
          style="--phrase-order: 1"
          >To a thing done.</span
        >
      </h2>
      <p>
        Seamlessly integrated. Snippets closes the gap between note-taking and
        task management. Build custom dashboards with task lists, due dates,
        priorities, and anything else that fits your workflow.
      </p>
    </header>
    <figure class="wide-figure">
      <div class="screenshot-mat">
        <Screenshot
          class="theme-light product-image"
          src="landing-page/tasks/light.png"
          alt="A task dashboard with Open tasks, Due after Today, and Done columns, plus priorities and due dates"
          loading="lazy"
        />
        <Screenshot
          class="theme-dark product-image"
          src="landing-page/tasks/dark.png"
          alt="A task dashboard with Open tasks, Due after Today, and Done columns, plus priorities and due dates"
          loading="lazy"
        />
      </div>
      <figcaption>Your tasks, in the context of everything else.</figcaption>
    </figure>
    <div class="quick-add">
      <div class="feature-copy heading-group">
        <p class="eyebrow">Quick-Add</p>
        <h3
          class="phrase-reveal"
          aria-label="Catch the thought. Keep your flow."
        >
          <span
            class="heading-phrase"
            aria-hidden="true"
            style="--phrase-order: 0"
            >Catch the thought.</span
          ><br />
          <span
            class="heading-phrase"
            aria-hidden="true"
            style="--phrase-order: 1"
            >Keep your flow.</span
          >
        </h3>
        <p>
          Capture quickly, the second a task comes to mind. Type in plain
          language, use aliases, and turn quick thoughts into structured tasks.
        </p>
        <a class="text-link" href="/docs/quick-add/"
          >Get to know Quick-Add
          <svg class="icon" aria-hidden="true">
            <use href="#arrow-right" />
          </svg></a
        >
      </div>
      <figure>
        <Screenshot
          class="theme-light product-image"
          src="landing-page/quick-add/light.png"
          alt="Quick-Add recognizes tomorrow at ten, a project alias, a start date, and a priority from a typed task"
          loading="lazy"
        />
        <Screenshot
          class="theme-dark product-image"
          src="landing-page/quick-add/dark.png"
          alt="Quick-Add recognizes tomorrow at ten, a project alias, a start date, and a priority from a typed task"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>
