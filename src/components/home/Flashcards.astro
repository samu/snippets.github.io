---
import Screenshot from "../Screenshot.astro";
---

<section
  id="flashcards"
  class="flashcards-section section-shell"
  aria-labelledby="flashcards-heading"
  data-tone="leaf"
>
  <header class="section-heading centered heading-group">
    <p class="eyebrow">Flashcards</p>
    <h2
      id="flashcards-heading"
      class="phrase-reveal"
      aria-label="Make a note. Make it stick."
    >
      <span class="heading-phrase" aria-hidden="true" style="--phrase-order: 0"
        >Make a note.</span
      ><br />
      <span
        class="heading-phrase color-phrase"
        aria-hidden="true"
        style="--phrase-order: 1"
        >Make it stick.</span
      >
    </h2>
    <p>
      A note in Snippets is a “Snippet”: a piece of information with its own way
      of showing up. Rich Text Snippets are for writing. Flashcard Snippets add
      a new possibility — turning what you’ve captured into what you remember.
    </p>
  </header>
  <article class="feature-row" data-tone="coral">
    <div class="feature-copy heading-group">
      <p class="feature-subtitle">Flashcard Snippet</p>
      <h3 class="phrase-reveal" aria-label="Two sides. One new connection.">
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 0"
          >Two sides.</span
        ><br />
        <span
          class="heading-phrase color-phrase"
          aria-hidden="true"
          style="--phrase-order: 1"
          >One new connection.</span
        >
      </h3>
      <p>
        A question on one side. An answer on the other. Just like a real-world
        flashcard, with all the flexibility of your notes. Perfect for a new
        language or your next big subject.
      </p>
    </div>
    <figure class="image-stage stage-paper">
      <Screenshot
        class="theme-light product-image"
        src="landing-page/single-flashcard/light.png"
        alt="A two-sided flashcard with carpenter on side A and Tischler on side B"
        loading="lazy"
      />
      <Screenshot
        class="theme-dark product-image"
        src="landing-page/single-flashcard/dark.png"
        alt="A two-sided flashcard with carpenter on side A and Tischler on side B"
        loading="lazy"
      />
    </figure>
  </article>
  <article class="feature-row reverse" data-tone="blue">
    <div class="feature-copy heading-group">
      <p class="feature-subtitle">Flashcard Dashboard</p>
      <h3
        class="phrase-reveal"
        aria-label="See what you know. Find what’s next."
      >
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 0"
          >See what you know.</span
        ><br />
        <span
          class="heading-phrase color-phrase"
          aria-hidden="true"
          style="--phrase-order: 1"
          >Find what’s next.</span
        >
      </h3>
      <p>
        A clear overview of every flashcard in your folder. Follow your learning
        progress over time and see cards ordered by relevance, calculated
        through a scoring algorithm.
      </p>
    </div>
    <figure class="image-stage stage-blue">
      <Screenshot
        class="theme-light product-image"
        src="landing-page/flashcard-deck/light.png"
        alt="Flashcard dashboard with a learning progress graph and cards ordered by relevance"
        loading="lazy"
      />
      <Screenshot
        class="theme-dark product-image"
        src="landing-page/flashcard-deck/dark.png"
        alt="Flashcard dashboard with a learning progress graph and cards ordered by relevance"
        loading="lazy"
      />
    </figure>
  </article>
  <article class="feature-row" data-tone="orchid">
    <div class="feature-copy heading-group">
      <p class="feature-subtitle">Session Wizard</p>
      <h3
        class="phrase-reveal"
        aria-label="A little practice. A lasting impression."
      >
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 0"
          >A little practice.</span
        ><br />
        <span
          class="heading-phrase color-phrase"
          aria-hidden="true"
          style="--phrase-order: 1"
          >A lasting impression.</span
        >
      </h3>
      <p>
        Step through your flashcards in an interactive session. Rate how well
        you know each answer, and Snippets will re-prioritize your cards for
        next time.
      </p>
      <a class="text-link" href="/docs/flashcards/"
        >Explore flashcards
        <svg class="icon" aria-hidden="true">
          <use href="#arrow-right" />
        </svg></a
      >
    </div>
    <figure class="image-stage stage-session">
      <Screenshot
        class="theme-light product-image session-image"
        src="landing-page/flashcard-session/light.png"
        alt="An interactive flashcard session with an answer revealed and Easy or Hard rating buttons"
        loading="lazy"
      />
      <Screenshot
        class="theme-dark product-image session-image"
        src="landing-page/flashcard-session/dark.png"
        alt="An interactive flashcard session with an answer revealed and Easy or Hard rating buttons"
        loading="lazy"
      />
    </figure>
  </article>
</section>

<style>
  .flashcards-section {
    padding-top: 135px;
  }
  .flashcards-section > .section-heading {
    margin-bottom: 90px;
  }
  .stage-session {
    background: transparent;
  }
  .session-image {
    max-width: 375px;
  }
  @media (max-width: 700px) {
    .flashcards-section {
      padding-top: 80px;
    }
    .flashcards-section > .section-heading {
      margin-bottom: 55px;
    }
    .session-image {
      max-width: 300px;
    }
  }
</style>
