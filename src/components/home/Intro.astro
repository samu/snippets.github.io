<div id="top" class="intro">
  <div class="intro-copy">
    <p class="intro-title">It starts with a note.</p>
    <p class="intro-description">And opens up to so much more.</p>
  </div>
  <a class="scroll-cue" href="#discover"
    ><span>Scroll to unfold</span
    ><svg class="icon" aria-hidden="true"><use href="#arrow-down" /></svg></a
  >
</div>

<style>
