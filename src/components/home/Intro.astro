<!-- This scene coordinates the page, header and note; these rules intentionally cross component boundaries. -->
<style is:global>
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      :root {
        --unfold-end: 85svh;
        --dock-start: var(--unfold-end);
        --dock-end: 145svh;
        --intro-end: var(--dock-end);
      }
      html:root {
        scroll-padding-top: 100px;
      }
      .site-header {
        animation: header-arrive linear both;
        animation-timeline: scroll(root block);
        animation-range: calc(var(--dock-end) - 10svh) var(--dock-end);
      }
      .site-header .wordmark img {
        visibility: hidden;
      }
      .hero-details,
      .home-sections,
      .site-footer {
        animation: page-arrive linear both;
        animation-timeline: scroll(root block);
        animation-range: var(--dock-start) var(--intro-end);
      }
      .site-footer {
        background: var(--paper);
      }
      .hero {
        --hero-top: 132px;
        animation: page-rise linear both;
        animation-timeline: scroll(root block);
        animation-range: var(--dock-start) var(--intro-end);
      }
      .hero .phrase-reveal {
        /* Wait for both the departing intro and the title's entrance into view. */
        --slogan-start: max(
          var(--dock-start),
          calc(
            var(--intro-end) + var(--hero-top) - 100svh +
              var(--heading-start, 22svh)
          )
        );
        animation-timeline: scroll(root block);
        animation-range: var(--slogan-start) calc(var(--slogan-start) + 1px);
      }
    }
  }
  @keyframes intro-away {
    from {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-16px);
    }
  }
  @keyframes cue-away {
    from {
      opacity: 1;
      visibility: visible;
    }
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  @keyframes header-arrive {
    from {
      opacity: 0;
      visibility: hidden;
    }
    to {
      opacity: 1;
      visibility: visible;
    }
  }
  @keyframes page-arrive {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes page-rise {
    from {
      transform: translateY(64px);
    }
    to {
      transform: translateY(0);
    }
  }
  @media (max-width: 700px) {
    @supports (animation-timeline: scroll()) {
      @media (prefers-reduced-motion: no-preference) {
        .hero {
          --hero-top: 115px;
        }
      }
    }
  }
</style>
