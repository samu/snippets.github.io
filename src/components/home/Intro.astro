        z-index: 3;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        font-size: 10px;
        color: var(--muted);
        animation: cue-away linear both;
        animation-timeline: scroll(root block);
        animation-range: 50svh var(--dock-start);
