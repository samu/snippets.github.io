---
import Screenshot from "../Screenshot.astro";
import release from "../../data/release.json";
---

<section
  id="mobile"
  class="mobile-section section-band"
  aria-labelledby="mobile-heading"
  data-tone="sky"
>
  <div class="section-shell mobile-layout">
    <div class="feature-copy heading-group">
      <p class="eyebrow">On iOS and Android <span class="badge">Beta</span></p>
      <h2
        id="mobile-heading"
        class="phrase-reveal"
        aria-label="Good ideas don’t stay at a desk."
      >
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 0"
          >Good ideas</span
        ><br />
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 1"
          >don’t stay</span
        ><br />
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 2"
          >at a desk.</span
        >
      </h2>
      <p>
        Your notes, right there with you. A familiar place to capture a thought,
        pick up where you left off, or make a little progress on the go.
      </p>
      <div class="mobile-actions">
        <a class="button" href="https://testflight.apple.com/join/3wpgBj2Z"
          ><svg class="icon" aria-hidden="true"><use href="#apple-icon" /></svg
          >iOS TestFlight <span aria-hidden="true">↗</span></a
        ><a
          class="button button-secondary"
          href={`https://github.com/samu/snippets/releases/download/v${release.version}/Snippets-${release.version}.apk`}
          >Android APK
          <svg class="icon" aria-hidden="true">
            <use href="#arrow-down" />
          </svg></a
        >
      </div>
    </div>
    <div class="mobile-showcase">
      <div class="phone mobile-phone">
        <Screenshot
          class="theme-light"
          src="landing-page/mobile-editor/light.png"
          alt="Snippets on mobile, showing a rich-text Friday journal entry and navigation bar"
          loading="lazy"
        />
        <Screenshot
          class="theme-dark"
          src="landing-page/mobile-editor/dark.png"
          alt="Snippets on mobile, showing a rich-text Friday journal entry and navigation bar"
          loading="lazy"
        />
      </div>
      <span class="mobile-caption">A little space, wherever you are.</span>
    </div>
  </div>
</section>

<style>
  .phone {
    padding: 6px;
    border: 1px solid oklch(0.88 0.002 80);
    border-radius: 29px;
    background: var(--paper);
    box-shadow: 0 18px 36px -20px oklch(0.25 0.002 80 / 0.2);
    overflow: hidden;
  }
  .phone :global(img) {
    border-radius: 24px;
    width: 100%;
  }

  .mobile-section {
    background: var(--paper);
    padding-block: 110px;
  }
  .mobile-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    align-items: center;
    max-width: 1000px;
  }
  .mobile-layout h2 {
    font-size: clamp(42px, 4.8vw, 62px);
    font-weight: 550;
    line-height: 1.1;
    margin-block: 20px 24px;
  }
  .mobile-layout .eyebrow .badge {
    margin-left: 7px;
  }
  .mobile-layout .feature-copy > p:not(.eyebrow) {
    max-width: 365px;
    font-size: 17px;
  }
  .mobile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .mobile-actions .button {
    font-size: 13px;
    padding: 11px 16px;
    min-height: 43px;
    gap: 8px;
  }
  .mobile-showcase {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
    position: relative;
  }
  .mobile-phone {
    position: relative;
    max-width: 265px;
    width: 75%;
    border-radius: 32px;
    padding: 7px;
  }
  .mobile-phone :global(img) {
    border-radius: 28px;
  }
  .mobile-caption {
    position: relative;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 1000px) {
    .mobile-layout {
      gap: 45px;
    }
    .mobile-layout .feature-copy > p:not(.eyebrow) {
      font-size: 15px;
    }
  }
  @media (max-width: 700px) {
    .mobile-section {
      padding-block: 75px;
    }
    .mobile-layout {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    .mobile-layout h2 {
      font-size: 46px;
    }
    .mobile-layout .feature-copy > p:not(.eyebrow) {
      font-size: 16px;
    }
    .mobile-phone {
      width: 220px;
    }
    .mobile-caption {
      font-size: 12px;
    }
  }
  :global(.home-page) .phone {
    border-color: var(--screenshot-edge);
    box-shadow: var(--screenshot-shadow);
  }
  :global(.home-page) .mobile-showcase {
    padding: 32px 24px 24px;
    background: var(--showcase);
    border: 1px solid var(--border);
    border-radius: 20px;
  }
  :global(.home-page) .mobile-section {
    background: var(--paper);
  }
  @media (max-width: 700px) {
    :global(.home-page) .mobile-showcase {
      padding: 24px 16px 20px;
      border-radius: 14px;
    }
  }
  @container theme style(--theme: dark) {
    :global(:root) .phone {
      border-color: var(--screenshot-edge);
    }
  }
</style>
