---
import release from "../../data/release.json";
---

<section
  id="mobile"
  class="mobile-section section-band"
  aria-labelledby="mobile-heading"
  data-tone="sky"
>
  <div class="section-shell mobile-layout">
    <div class="feature-copy heading-group">
      <p class="eyebrow">On iOS and Android <span class="badge">Beta</span></p>
      <h2
        id="mobile-heading"
        class="phrase-reveal"
        aria-label="Good ideas don’t stay at a desk."
      >
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 0"
          >Good ideas</span
        ><br />
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 1"
          >don’t stay</span
        ><br />
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 2"
          >at a desk.</span
        >
      </h2>
      <p>
        Your notes, right there with you. A familiar place to capture a thought,
        pick up where you left off, or make a little progress on the go.
      </p>
      <div class="mobile-actions">
        <a class="button" href="https://testflight.apple.com/join/3wpgBj2Z"
          ><svg class="icon" aria-hidden="true"><use href="#apple-icon" /></svg
          >iOS TestFlight <span aria-hidden="true">↗</span></a
        ><a
          class="button button-secondary"
          href={`https://github.com/samu/snippets/releases/download/v${release.version}/Snippets-${release.version}.apk`}
          >Android APK
          <svg class="icon" aria-hidden="true">
            <use href="#arrow-down" />
          </svg></a
        >
      </div>
    </div>
    <div class="mobile-showcase">
      <div class="phone mobile-phone">
        <img
          class="theme-light"
          src="/assets/screenshots/light/mobile-editor.webp"
          width="786"
          height="1704"
          alt="Snippets on mobile, showing a rich-text Friday journal entry and navigation bar"
          loading="lazy"
        />
        <img
          class="theme-dark"
          src="/assets/screenshots/dark/mobile-editor.webp"
          width="786"
          height="1704"
          alt="Snippets on mobile, showing a rich-text Friday journal entry and navigation bar"
          loading="lazy"
        />
      </div>
      <span class="mobile-caption">A little space, wherever you are.</span>
    </div>
  </div>
</section>
