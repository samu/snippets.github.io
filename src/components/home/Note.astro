<!-- Shared geometry keeps the note aligned with the intro and header at every breakpoint. -->
<style is:global>
  :root {
    --page-edge: max(32px, (100vw - 1160px) / 2);
    --note-size: clamp(270px, 34vw, 410px);
  }

  @media (min-width: 1600px) {
    :root {
      --note-size: 440px;
    }
  }
  @media (max-width: 700px) {
    :root {
      --page-edge: 22px;
      --note-size: clamp(245px, 68vw, 320px);
    }
  }
  @media (max-height: 560px) and (min-width: 701px) {
    :root {
      --note-size: 230px;
    }
  }
</style>

