---
import "../../styles/note-atlas.css";
---

<div class="note-scene" aria-hidden="true">
  <div class="note-mover"><div class="note-sprite"></div></div>
</div>

<!-- Shared geometry keeps the note aligned with the intro and header at every breakpoint. -->
<style is:global>
  :root {
    --page-edge: max(32px, (100vw - 1160px) / 2);
    --note-size: clamp(270px, 34vw, 410px);
  }

  @media (min-width: 1600px) {
    :root {
      --note-size: 440px;
    }
  }
  @media (max-width: 700px) {
    :root {
      --page-edge: 22px;
      --note-size: clamp(245px, 68vw, 320px);
    }
  }
  @media (max-height: 560px) and (min-width: 701px) {
    :root {
      --note-size: 230px;
    }
  }
</style>

<style>
  .note-scene {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .note-scene {
        display: block;
        container-name: note-docking;
        --note-dock-state: intro;
        /* Only the state follows scroll; the movement runs on elapsed time. */
        animation: note-dock-state auto step-end both;
        animation-timeline: scroll(root block);
        animation-range: var(--dock-start) calc(var(--dock-start) + 1px);
      }
      .note-mover {
        position: fixed;
        z-index: 30;
        /* Match the first scroll state before the timeline's initial sample. */
        left: 50%;
        top: 37svh;
        width: var(--note-size);
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        pointer-events: none;
        transition:
          left var(--dock-duration) cubic-bezier(0.4, 0.2, 0.3, 1),
          top var(--dock-duration) cubic-bezier(0.4, 0.2, 0.3, 1),
          width var(--dock-duration) cubic-bezier(0.4, 0.2, 0.3, 1);
      }
      @container note-docking style(--note-dock-state: header) {
        .note-mover {
          left: calc(var(--page-edge) + 20px);
          top: 36px;
          width: 60px;
        }
      }
      .note-sprite {
        width: 100%;
        height: 100%;
        background-position: 0% 0%;
        background-repeat: no-repeat;
        animation: unfold-note steps(1, end) both;
        animation-timeline: scroll(root block);
        animation-range: 0px var(--unfold-end);
      }
    }
  }
  @keyframes note-dock-state {
    from {
      --note-dock-state: intro;
    }
    to {
      --note-dock-state: header;
    }
  }
</style>
