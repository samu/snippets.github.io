---
import SectionLight from "./SectionLight.astro";
import Screenshot from "../Screenshot.astro";
---

<section
  id="features"
  class="overview section-shell"
  aria-labelledby="overview-heading"
  data-tone="sage"
>
  <header class="section-heading centered" data-light-scene>
    <SectionLight />
    <h2
      id="overview-heading"
      class="phrase-reveal"
      aria-label="One place for everything."
    >
      <span class="heading-phrase" aria-hidden="true" style="--phrase-order: 0"
        >One place for</span
      ><br />
      <span
        class="heading-phrase color-phrase"
        aria-hidden="true"
        style="--phrase-order: 1"
        >everything.</span
      >
    </h2>
    <p class="three-promises">
      <span>Starts simple.</span><span>Becomes powerful.</span
      ><span>Stays affordable.</span>
    </p>
    <p>
      Forget the clutter of too many tools and the friction of disconnected
      systems. Break free from rigid rules and bring everything into one place.
      Get organized your way.
    </p>
  </header>

  <div class="building-blocks">
    <p>
      A few carefully crafted building blocks.<br />A whole new way to take
      notes.
    </p>
  </div>

  <article class="feature-row">
    <div class="feature-copy heading-group" data-light-scene>
      <SectionLight variant="linen" area="copy" />
      <p class="eyebrow">Rich text</p>
      <h3 class="phrase-reveal" aria-label="Just you. And your thoughts.">
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 0"
          >Just you.</span
        ><br />
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 1"
          >And your thoughts.</span
        >
      </h3>
      <p>
        Everything starts with text. Snippets gives it the attention it deserves
        — with a rich-text editor that stays out of your way and simply works.
      </p>
      <p>
        No clumsy block-based layouts, no formatting that traps you as you
        write, no jumpy markdown quirks. Made with utmost precision, for a
        writing experience we think you’ll love.
      </p>
      <a class="text-link" href="/docs/rich-text-editor/"
        >Meet your new editor
        <svg class="icon" aria-hidden="true">
          <use href="#arrow-right" />
        </svg></a
      >
    </div>
    <figure class="image-stage stage-paper">
      <Screenshot
        class="theme-light product-image editor-image"
        src="landing-page/friday/light.png"
        alt="A Friday journal entry with rich text, highlights, a quote, and a Focus & Clarity task list"
        loading="lazy"
      />
      <Screenshot
        class="theme-dark product-image editor-image"
        src="landing-page/friday/dark.png"
        alt="A Friday journal entry with rich text, highlights, a quote, and a Focus & Clarity task list"
        loading="lazy"
      />
    </figure>
  </article>

  <article class="feature-row reverse">
    <div class="feature-copy heading-group" data-light-scene>
      <SectionLight variant="mist" area="copy" />
      <p class="eyebrow">Collections</p>
      <h3 class="phrase-reveal" aria-label="A place for every kind of thought.">
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 0"
          >A place for every</span
        ><br />
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 1"
          >kind of thought.</span
        >
      </h3>
      <p>
        Use collections to group your notes. Folders, lists, tables, and
        timelines — static or dynamic, and always your choice.
      </p>
      <p>
        Combined with our unique attributes concept, you can organize your
        content in a way that feels entirely your own.
      </p>
      <a class="text-link" href="/docs/collections/"
        >Explore collections
        <svg class="icon" aria-hidden="true">
          <use href="#arrow-right" />
        </svg></a
      >
    </div>
    <figure class="image-stage stage-blue">
      <Screenshot
        class="theme-light product-image"
        src="landing-page/collections/light.png"
        alt="A collection of notes displayed as a table, with descriptions, priorities, and due dates"
        loading="lazy"
      />
      <Screenshot
        class="theme-dark product-image"
        src="landing-page/collections/dark.png"
        alt="A collection of notes displayed as a table, with descriptions, priorities, and due dates"
        loading="lazy"
      />
    </figure>
  </article>

  <article class="feature-row">
    <div class="feature-copy heading-group" data-light-scene>
      <SectionLight variant="pearl" area="copy" />
      <p class="eyebrow">Dashboards</p>
      <h3 class="phrase-reveal" aria-label="See how it all fits together.">
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 0"
          >See how it</span
        ><br />
        <span
          class="heading-phrase"
          aria-hidden="true"
          style="--phrase-order: 1"
          >all fits together.</span
        >
      </h3>
      <p>
        Work rarely happens in isolation. Place related content side by side and
        organize it in a way that makes sense at a glance.
      </p>
      <p>
        Less switching context. More seeing the whole picture. Our dashboards
        bring everything together in one place — once you’ve used them, it’s
        hard to go back.
      </p>
      <a class="text-link" href="/docs/organizing-your-notes/"
        >Make space for the big picture
        <svg class="icon" aria-hidden="true">
          <use href="#arrow-right" />
        </svg></a
      >
    </div>
    <figure class="image-stage stage-green">
      <Screenshot
        class="theme-light product-image"
        src="landing-page/dashboard/light.png"
        alt="A task dashboard bringing open tasks, upcoming tasks, and completed tasks together in columns"
        loading="lazy"
      />
      <Screenshot
        class="theme-dark product-image"
        src="landing-page/dashboard/dark.png"
        alt="A task dashboard bringing open tasks, upcoming tasks, and completed tasks together in columns"
        loading="lazy"
      />
    </figure>
  </article>

  <aside class="pricing-note">
    <div>
      <p class="eyebrow">Free to begin. Room to grow.</p>
      <p>Start with everything you need. <span>Grow at your own pace.</span></p>
      <span class="pricing-description"
        >Use Snippets for free, or add Pro with a one-time purchase.</span
      >
    </div>
    <a class="text-link" href="/pricing/"
      >Find your fit
      <svg class="icon" aria-hidden="true"><use href="#arrow-right" /></svg></a
    >
  </aside>
</section>

<style>
  .overview {
    padding-top: 146px;
  }
  .three-promises {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin-top: 26px;
    font-size: 15px;
    font-weight: 400;
    color: var(--ink);
  }
  .building-blocks {
    display: flex;
    justify-content: center;
    margin: 64px auto 76px;
    font-size: 15px;
    text-align: center;
    color: var(--muted);
  }
  .editor-image {
    max-width: 490px;
  }
  .pricing-note {
    margin: 0 0 132px;
    padding: 30px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .pricing-note p:not(.eyebrow) {
    margin-block: 8px 5px;
    font-size: 19px;
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .pricing-note p span {
    color: var(--muted);
  }
  .pricing-note .text-link {
    flex-shrink: 0;
    font-size: 14px;
  }
  .pricing-description {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }
  @media (max-width: 700px) {
    .overview {
      padding-top: 85px;
    }
    .three-promises {
      gap: 8px 14px;
      font-size: 13px;
      margin-top: 22px;
    }
    .building-blocks {
      margin: 43px 0 48px;
      font-size: 14px;
    }
    .pricing-note {
      margin-bottom: 75px;
      padding: 26px 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
    .pricing-note p:not(.eyebrow) {
      font-size: 17px;
      line-height: 1.5;
    }
    .pricing-note p span {
      display: block;
    }
    .pricing-description {
      display: block;
      margin-top: 10px;
    }
  }
  :global(.home-page) .three-promises {
    color: var(--muted);
  }
  :global(.home-page) .three-promises span {
    font-weight: 500;
  }
  :global(.home-page) .pricing-note {
    padding: 31px 34px;
    border: 1px solid var(--border);
    background: var(--paper);
    border-radius: 10px;
  }
  :global(.home-page) .pricing-note p:not(.eyebrow) {
    font-weight: 550;
  }
  @media (max-width: 760px) {
    :global(.home-page) .pricing-note {
      padding: 25px;
    }
    :global(.home-page) .three-promises {
      gap: 12px 20px;
    }
  }
</style>
