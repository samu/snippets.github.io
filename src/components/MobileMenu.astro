---
const { current } = Astro.props;
const links = [
  ["Features", "/#features", "features"],
  ["Pricing", "/pricing/", "pricing"],
  ["Docs", "/docs/", "docs"],
  ["News", "/news/", "news"],
];
---

<details class="mobile-menu">
  <summary>
    Menu
    <svg
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M4 7h12M4 13h12" />
    </svg>
  </summary>
  <div class="mobile-menu-links">
    {links.map(([label, href, key]) => <a
      href={href}
      aria-current={current === key ? "page" : undefined}
      >{label}</a
    >)}
    <a class="mobile-menu-download" href="/#download"
      >Get Snippets <span aria-hidden="true">↗</span></a
    >
  </div>
</details>

<style>
  .mobile-menu {
    display: none;
    position: relative;
    color: var(--heading);
  }
  .mobile-menu summary {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    cursor: pointer;
    list-style: none;
    font-size: 12px;
    font-weight: 500;
    border-radius: 5px;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu summary :global(svg) {
    width: 18px;
    height: 18px;
  }
  .mobile-menu summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .mobile-menu-links {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: min(240px, calc(100vw - 40px));
    padding: 8px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow);
  }
  .mobile-menu-links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px;
    font-size: 13px;
    border-radius: 6px;
  }
  .mobile-menu-links a:hover,
  .mobile-menu-links a[aria-current="page"] {
    background: var(--paper);
    color: var(--accent);
  }
  .mobile-menu-links .mobile-menu-download {
    border-top: 1px solid var(--border);
    border-radius: 0 0 6px 6px;
    margin-top: 6px;
  }
  @media (max-width: 760px) {
    .mobile-menu {
      display: block;
    }
  }
  @media print {
    .mobile-menu {
      display: none;
    }
  }
</style>
