---
const { post } = Astro.props;
---

<div class="post-meta">
  <span class="post-kind">{post.label}</span>
  {post.version && <span class="post-version">v{post.version}</span>}
  <time datetime={post.date}>{post.dateLabel}</time>
  {post.draft ? (
    <span class="status-label">Draft</span>
  ) : (
    post.sample && <span class="status-label">Sample</span>
  )}
</div>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }
  .post-kind {
    color: var(--post-color);
    font-weight: 650;
  }
  .post-kind::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    margin-right: 7px;
    vertical-align: 1px;
  }
  .post-version {
    font-variant-numeric: tabular-nums;
  }
  .status-label {
    padding: 1px 6px;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 10px;
  }
  @media (max-width: 380px) {
    .post-meta {
      gap: 8px 10px;
    }
  }
</style>
