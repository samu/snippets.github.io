---
import path from "node:path";
import { getImage } from "astro:assets";
import { getScreenshot, hasScreenshot } from "../../lib/screenshots";
const { src, caption, alt, maxWidth } = Astro.props;
const resolved = src && (path.extname(src) ? src : `${src}/light.png`);
const dark = resolved?.replace(/\/light\.png$/, "/dark.png");
const paired = dark && dark !== resolved && hasScreenshot(dark);
const label =
  alt ||
  caption ||
  (src && path.basename(src, path.extname(src)).replace(/[-_]/g, " "));
const images = resolved
  ? await Promise.all(
      [resolved, ...(paired ? [dark] : [])].map(async (file, index) => ({
        image: await getImage({
          src: await getScreenshot(file),
          format: "webp",
        }),
        theme: paired ? (index ? "theme-dark" : "theme-light") : "",
      })),
    )
  : [];
---

<figure class="doc-figure" style={maxWidth ? { maxWidth } : undefined}>
  {images.map(({ image, theme }) => <a
    class:list={["image-link", theme]}
    href={image.src}
    target="_blank"
    rel="noopener"
    aria-label={`Open image: ${label}`}
    ><img
      {...image.attributes}
      src={image.src}
      alt={label}
      loading="lazy"
      decoding="async"
  /></a>)}
  <slot />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .doc-figure {
    min-width: 0;
    margin: 30px 0 36px;
    width: 100%;
  }
  .doc-figure :global(img) {
    margin: auto;
    max-height: 720px;
    object-fit: contain;
    border-radius: 7px;
    border: 1px solid var(--screenshot-edge);
    background: #fafaf9;
  }
  .image-link {
    display: block;
    cursor: zoom-in;
    border-radius: 8px;
  }
  .image-link:hover :global(img) {
    border-color: #d0d6db;
  }
  .doc-figure :global(.doc-row) {
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--paper);
    margin: 0;
  }
  @media (max-width: 760px) {
    .doc-figure {
      margin: 26px 0;
    }
  }
  @media print {
    .doc-figure {
      break-inside: avoid;
    }
  }
  :global(.docs-page) .image-link:hover :global(img) {
    border-color: var(--accent-border);
  }
  :global(.docs-page) .doc-figure > .image-link {
    padding: clamp(10px, 1.6vw, 18px);
    background: var(--showcase);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  @media (max-width: 700px) {
    :global(.docs-page) .doc-figure > .image-link {
      padding: 8px;
      border-radius: 9px;
    }
  }
  @media print {
    :global(.docs-page) .doc-figure > .image-link {
      padding: 0;
      background: none;
      border: 0;
    }
  }
  @container theme style(--theme: dark) {
    :global(:root) :global(.docs-page) .doc-figure :global(img) {
      background: var(--panel);
    }
  }
</style>
