---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import IconLibrary from "../components/home/IconLibrary.astro";
import Note from "../components/home/Note.astro";
import Intro from "../components/home/Intro.astro";
import Footer from "../components/home/Footer.astro";
import Hero from "../components/home/Hero.astro";
import Download from "../components/home/Download.astro";
import Features from "../components/home/Features.astro";
import Tasks from "../components/home/Tasks.astro";
import Sync from "../components/home/Sync.astro";
import Encryption from "../components/home/Encryption.astro";
import Journal from "../components/home/Journal.astro";
import Flashcards from "../components/home/Flashcards.astro";
import Mobile from "../components/home/Mobile.astro";
import Closing from "../components/home/Closing.astro";
import { homeStyles } from "../lib/styles";
---

<BaseLayout
  title="Snippets — Note-taking that grows with you."
  description="A little space for everything on your mind. Snippets brings notes, tasks, journals, and flashcards together in a calm, local-first workspace."
  bodyClass="home-page"
  styles={homeStyles}
>
  <a class="skip-link" href="#discover">Skip to content</a>
  <IconLibrary />
  <Note />
  <Header variant="home" />
  <Intro />
  <main id="discover" tabindex="-1">
    <Hero />
    <div class="home-sections">
      <Download />
      <Features />
      <Tasks />
      <Sync />
      <Encryption />
      <Journal />
      <Flashcards />
      <Mobile />
      <Closing />
    </div>
  </main>
  <Footer />
</BaseLayout>
