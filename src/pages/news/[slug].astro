---
import NewsLayout from "../../layouts/NewsLayout.astro";
import PostMeta from "../../components/news/PostMeta.astro";
import PostCard from "../../components/news/PostCard.astro";
import Icon from "../../components/Icon.astro";
import Figure from "../../components/docs/Figure.astro";
import Callout from "../../components/docs/Callout.astro";
import { news } from "../../data/news";
export function getStaticPaths() {
  return news.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = post;
const related = news.filter((item) => item.slug !== post.slug).slice(0, 2);
---

<NewsLayout
  title={post.title}
  description={post.description}
  sample={post.sample}
>
  <div class="news-shell">
    <a class="news-back" href="/news/"><Icon /> All news</a>
    <article class:list={["update-article", `update-${post.kind}`]}>
      <header class="update-article-header">
        <PostMeta post={post} />
        <h1>{post.title}</h1>
        <p class="update-deck">{post.description}</p>
        <div class="post-byline">
          <img
            src="/assets/note/note-open.webp"
            width="40"
            height="40"
            alt=""
          /><span>From Snippets</span>
        </div>
      </header>
      {post.sample && <p class="sample-notice">
        Sample
        {post.kind === "release"
          ? "release notes"
          : post.kind === "blog"
            ? "blog post"
            : "announcement"}
        — illustrative content to preview this format.
      </p>}
      <div class="prose"><Content components={{ Figure, Callout }} /></div>
      <div class="post-end">
        <span>Thanks for reading.</span
        ><a href="/news/">Back to news <Icon /></a>
      </div>
    </article>
    {related.length > 0 && <aside
      class="news-more"
      aria-labelledby="keep-reading"
    >
      <div class="news-section-heading">
        <h2 id="keep-reading">A little more to explore.</h2>
        <a href="/news/">All news <Icon /></a>
      </div>
      <div class="news-grid">
        {related.map((item) => (
          <PostCard post={item} />
        ))}
      </div>
    </aside>}
  </div>
</NewsLayout>

<style>
  .post-end a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .post-end :global(svg) {
    width: 15px;
    height: 15px;
  }
  .news-back:hover,
  .post-end a:hover {
    color: var(--accent);
  }
  .news-back {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 12px;
    color: var(--muted);
    margin-block: 40px 48px;
  }
  .news-back :global(svg) {
    transform: rotate(180deg);
    width: 16px;
    height: 16px;
  }
  .update-article {
    max-width: 720px;
    margin-inline: auto;
  }
  .update-article-header h1 {
    font-size: clamp(38px, 4.6vw, 58px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.04em;
    margin-block: 22px;
    text-wrap: balance;
  }
  .update-deck {
    font-size: 19px;
    line-height: 1.7;
  }
  .post-byline {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--muted);
    margin-block: 22px 30px;
  }
  .post-byline :global(img) {
    margin-left: -6px;
  }
  .sample-notice {
    font-size: 11px;
    line-height: 1.7;
    color: var(--muted);
    padding-block: 14px;
    border-block: 1px solid var(--border);
    margin-bottom: 34px;
  }
  .update-article .prose {
    font-size: 16px;
    line-height: 1.85;
  }
  .update-article .prose :global(h2) {
    font-size: 26px;
  }
  .post-end {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid var(--border);
    margin-top: 52px;
    padding-top: 24px;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .news-back {
      margin-block: 28px 36px;
    }
    .update-article-header h1 {
      font-size: 39px;
    }
    .update-deck {
      font-size: 17px;
    }
    .update-article .prose {
      font-size: 15px;
    }
    .update-article .prose :global(h2) {
      font-size: 23px;
    }
  }
  @media (max-width: 380px) {
    .update-article-header h1 {
      font-size: 34px;
    }
  }
  @media print {
    .news-back,
    .post-end {
      display: none;
    }
    .update-article {
      max-width: none;
    }
  }
</style>
