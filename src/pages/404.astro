---
import LegalLayout from "../layouts/LegalLayout.astro";
---

<LegalLayout title="Page not found · Snippets" noindex standalone>
  <main class="legal-page">
    <a class="wordmark" href="/"
      ><img
        src="/assets/note/note-open.webp"
        width="48"
        height="48"
        alt=""
      /><span>Snippets</span></a
    >
    <div class="article-header">
      <h1 class="legal-title">This page has moved.</h1>
      <p>Let’s get you back to your notes.</p>
    </div>
    <p><a class="get-app" href="/">Back to the homepage</a></p>
    <p class="legal-footerNote">
      Looking for a guide? <a href="/docs/">Explore the documentation</a>.
    </p>
  </main>
</LegalLayout>
