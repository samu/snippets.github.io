---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import { newsStyles } from "../lib/styles";
const { title = "News", description, sample = false } = Astro.props;
---

<BaseLayout
  title={`${title} · Snippets`}
  description={description}
  noindex={sample}
  bodyClass="docs-page news-page"
  bodyId="top"
  styles={newsStyles}
>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header variant="news" />
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="news-footer news-shell">
    <a class="wordmark" href="/">Snippets</a>
    <p>Start with a note.</p>
    <nav aria-label="Footer navigation">
      <a href="/docs/">Documentation</a>
      <a href="mailto:support@snippets.ch">Contact</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </nav>
    <span>© {new Date().getUTCFullYear()} Snippets</span>
  </footer>
</BaseLayout>

<style>
  .news-footer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px 32px;
    border-top: 1px solid var(--border);
    padding-block: 32px 40px;
    font-size: 11px;
    color: var(--muted);
  }
  .news-footer .wordmark {
    font-size: 18px;
  }
  .news-footer p {
    grid-row: 2;
    line-height: 1.7;
  }
  .news-footer nav {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .news-footer > span {
    text-align: right;
  }
  .news-footer a:hover {
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .news-footer {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .news-footer nav {
      grid-column: auto;
      grid-row: auto;
      flex-wrap: wrap;
      gap: 14px 24px;
      margin-block: 6px;
    }
    .news-footer > span {
      text-align: left;
    }
  }
  @media print {
    .news-footer {
      display: none;
    }
  }
</style>
