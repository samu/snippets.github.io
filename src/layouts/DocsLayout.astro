---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Navigation from "../components/docs/Navigation.astro";
import Icon from "../components/Icon.astro";
import { pages } from "../data/docs";
import { docsStyles } from "../lib/styles";
const { page, overview = false } = Astro.props;
const title = overview ? "Documentation" : page.title;
const description = overview
  ? "Learn your way around Snippets. Guides to writing, organizing, and keeping your notes in sync."
  : page.description;
const headings = page?.headings || [];
const toc = headings.filter(
  (item) => item.depth === (headings.some((item) => item.depth === 2) ? 2 : 3),
);
const index = pages.findIndex((item) => item.slug === page?.slug);
const adjacent = [
  { page: pages[index - 1], direction: "previous", label: "Previous" },
  { page: pages[index + 1], direction: "next", label: "Next" },
];
---

<BaseLayout
  title={`${title} · Snippets Docs`}
  description={description}
  bodyClass="docs-page"
  bodyId="top"
  styles={docsStyles}
>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header variant="docs" />
  <details class="mobile-navigation">
    <summary>Browse documentation<span aria-hidden="true">＋</span></summary>
    <nav aria-label="Documentation"><Navigation current={page?.slug} /></nav>
  </details>
  <div class:list={["docs-layout", { "overview-layout": overview }]}>
    <aside class="sidebar">
      <nav aria-label="Documentation"><Navigation current={page?.slug} /></nav>
      <a class="sidebar-help" href="mailto:support@snippets.ch"
        >A question? Get in touch <Icon
      /></a>
    </aside>
    <main
      id="main"
      tabindex="-1"
      class={overview ? "overview" : "article-main"}
    >
      {overview ? (
        <slot />
      ) : (
        <>
          <div class="breadcrumb">
            <a href="/docs/">Documentation</a><span aria-hidden="true">/</span
            ><span>{page.group}</span>
          </div>
          <header class="article-header">
            <div class="article-meta">
              <span>Snippets guide</span
              ><span
                >{page.draft
                  ? "Guide in progress"
                  : `${page.minutes} min read`}</span
              >
            </div>
            <h1>{page.title}</h1>
            <p>{page.description}</p>
          </header>
          {toc.length > 0 && <details class="inline-toc">
            <summary>On this page</summary>
            <ul>
              {toc.map((item) => <li>
                <a href={`#${item.slug}`}>{item.text}</a>
              </li>)}
            </ul>
          </details>}
          <article class="prose"><slot /></article>
          <nav class="page-navigation" aria-label="Adjacent articles">
            {adjacent.map(({ page, direction, label }) =>
              page ? (
                <a class={`page-turn ${direction}`} href={`/docs/${page.slug}/`}
                  ><span>{label}</span><strong>{page.title} <Icon /></strong></a
                >
              ) : (
                <span></span>
              ),
            )}
          </nav>
        </>
      )}
      <footer class="docs-footer">
        <span>© 2026 Snippets</span><a href="#top">Back to top ↑</a>
      </footer>
    </main>
    {!overview && <aside class="page-outline" aria-label="On this page">
      {toc.length > 0 && (
        <><p>On this page</p>
          <nav>
            <ul>
              {toc.map((item) => <li>
                <a href={`#${item.slug}`}>{item.text}</a>
              </li>)}
            </ul>
          </nav></>
      )}
      <div class="outline-help">
        <p>Need a hand?</p>
        <a href="mailto:support@snippets.ch">We’re here to help <Icon /></a>
      </div>
    </aside>}
  </div>
</BaseLayout>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 210px minmax(0, 760px) 180px;
    column-gap: 54px;
    max-width: 1440px;
    width: calc(100% - 80px);
    margin: auto;
    align-items: start;
  }
  .sidebar {
    position: sticky;
    top: 76px;
    height: calc(100svh - 76px);
    overflow-y: auto;
    padding: 36px 12px 28px 0;
    scrollbar-width: thin;
    scrollbar-color: #ddd transparent;
  }
  .sidebar nav {
    padding-bottom: 18px;
  }
  .page-outline ul,
  .inline-toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-help {
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 18px 9px 0;
    border-top: 1px solid var(--border);
    color: var(--muted);
  }
  .sidebar-help :global(svg) {
    width: 14px;
    height: 14px;
  }
  .sidebar-help:hover {
    color: var(--accent);
  }
  .article-main {
    min-width: 0;
    padding-top: 46px;
  }
  .breadcrumb {
    font-size: 11px;
    display: flex;
    gap: 12px;
    color: var(--muted);
    align-items: center;
    line-height: 1.6;
  }
  .breadcrumb a:hover {
    color: var(--accent);
  }
  .breadcrumb > span:nth-child(2) {
    color: #b9b9b7;
  }
  .article-header {
    margin: 33px 0 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 13px;
    font-size: 10px;
    color: var(--muted);
    margin-bottom: 15px;
  }
  .article-meta > span + span:before {
    content: "·";
    margin-right: 13px;
  }
  .article-header h1 {
    font-size: clamp(32px, 3.1vw, 44px);
    line-height: 1.17;
    font-weight: 550;
    letter-spacing: -0.035em;
  }
  .article-header > p {
    font-size: 16px;
    line-height: 1.7;
    max-width: 600px;
    color: var(--muted);
    margin-top: 16px;
  }
  .page-outline {
    position: sticky;
    top: 118px;
    margin-top: 93px;
    font-size: 11px;
    max-height: calc(100svh - 150px);
    overflow: auto;
    scrollbar-width: thin;
  }
  .page-outline > p {
    font-weight: 650;
    color: var(--heading);
    margin-bottom: 16px;
  }
  .page-outline li {
    border-left: 1px solid var(--border);
  }
  .page-outline li a {
    display: block;
    line-height: 1.65;
    padding: 7px 0 7px 14px;
    color: var(--muted);
  }
  .page-outline a:hover {
    color: var(--accent);
  }
  .outline-help {
    border-top: 1px solid var(--border);
    padding-top: 22px;
    margin-top: 30px;
  }
  .outline-help p {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .outline-help a {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 11px;
    color: var(--accent);
  }
  .outline-help :global(svg) {
    width: 14px;
    height: 14px;
  }
  .inline-toc,
  .mobile-navigation {
    display: none;
  }
  .page-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 64px;
    padding-top: 25px;
    border-top: 1px solid var(--border);
  }
  .page-turn {
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .page-turn > span {
    font-size: 10px;
    color: var(--muted);
  }
  .page-turn strong {
    font-weight: 550;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 8px;
    color: var(--heading);
  }
  .page-turn :global(svg) {
    width: 16px;
    height: 16px;
  }
  .page-turn.previous :global(svg) {
    transform: rotate(180deg);
    order: -1;
  }
  .page-turn.previous strong {
    justify-content: flex-start;
  }
  .page-turn:hover {
    background: var(--paper);
    border-color: #d6dde1;
  }
  .docs-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 60px;
    padding: 24px 0 32px;
    border-top: 1px solid var(--border);
    font-size: 10px;
    color: var(--muted);
  }
  .docs-footer a:hover {
    color: var(--accent);
  }
  .overview-layout {
    grid-template-columns: 210px minmax(0, 1fr);
    column-gap: 64px;
  }
  .overview {
    padding-top: 58px;
    min-width: 0;
    max-width: 1020px;
  }
  @media (min-width: 1500px) {
    .overview {
      padding-right: 40px;
    }
  }
  @media (max-width: 1240px) {
    .docs-layout {
      grid-template-columns: 205px minmax(0, 1fr);
      column-gap: 42px;
      max-width: 1120px;
    }
    .page-outline {
      display: none;
    }
    .inline-toc {
      display: block;
      border: 1px solid var(--border);
      border-radius: 7px;
      margin-bottom: 30px;
      font-size: 12px;
    }
    .inline-toc summary {
      cursor: pointer;
      padding: 14px 18px;
      color: var(--heading);
    }
    .inline-toc ul {
      padding: 0 18px 17px;
    }
    .inline-toc li {
      padding: 6px 0;
      line-height: 1.5;
    }
    .inline-toc a:hover {
      color: var(--accent);
    }
    .overview {
      padding-top: 45px;
    }
  }
  @media (max-width: 1000px) {
    .docs-layout {
      width: calc(100% - 48px);
      grid-template-columns: 185px minmax(0, 1fr);
      column-gap: 28px;
    }
    .article-header h1 {
      font-size: 36px;
    }
  }
  @media (max-width: 760px) {
    .sidebar {
      display: none;
    }
    .docs-layout {
      display: block;
      width: calc(100% - 40px);
      max-width: 660px;
    }
    .mobile-navigation {
      display: block;
      border-bottom: 1px solid var(--border);
      background: var(--paper);
    }
    .mobile-navigation > summary {
      padding: 15px 20px;
      font-size: 11px;
      color: var(--heading);
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .mobile-navigation > summary::-webkit-details-marker {
      display: none;
    }
    .mobile-navigation[open] > summary > span {
      transform: rotate(45deg);
    }
    .mobile-navigation > nav {
      padding: 10px 14px 18px;
      max-height: 65svh;
      overflow: auto;
      border-top: 1px solid var(--border);
      background: #fff;
    }
    .mobile-navigation :global(.nav-group a) {
      font-size: 12px;
      padding: 9px 11px;
    }
    .mobile-navigation :global(.nav-group) {
      margin-bottom: 20px;
    }
    .mobile-navigation :global(.nav-overview) {
      margin-bottom: 20px;
    }
    .article-main {
      padding-top: 27px;
    }
    .article-header {
      margin-top: 26px;
      padding-bottom: 26px;
      margin-bottom: 26px;
    }
    .article-header h1 {
      font-size: 34px;
    }
    .article-header > p {
      font-size: 14px;
    }
    .article-meta {
      font-size: 10px;
    }
    .page-navigation {
      gap: 12px;
      margin-top: 44px;
    }
    .page-turn {
      padding: 13px;
    }
    .page-turn strong {
      font-size: 11px;
      line-height: 1.5;
    }
    .overview {
      padding-top: 37px;
    }
    .docs-footer {
      margin-top: 44px;
      padding-bottom: 24px;
    }
  }
  @media (max-width: 420px) {
    .docs-layout {
      width: calc(100% - 36px);
    }
    .article-header h1 {
      font-size: 31px;
    }
    .page-navigation {
      grid-template-columns: 1fr;
    }
    .page-navigation > span:empty {
      display: none;
    }
    .breadcrumb {
      font-size: 10px;
      gap: 8px;
    }
  }
  @media print {
    .sidebar,
    .page-outline,
    .mobile-navigation,
    .inline-toc,
    .page-navigation,
    .docs-footer {
      display: none;
    }
    .docs-layout {
      display: block;
      width: 100%;
      max-width: none;
    }
    .article-main {
      padding: 0;
    }
    .article-header h1 {
      font-size: 28pt;
    }
  }
  :global(.docs-page) .article-header > p {
    color: var(--ink);
  }
  :global(.docs-page) .article-meta > span:first-child {
    color: var(--muted);
    font-weight: 600;
  }
  :global(.docs-page) .page-turn:hover {
    border-color: var(--accent-border);
  }
  :global(.docs-page) .mobile-navigation > nav {
    background: var(--white);
  }
  :global(.docs-page) .sidebar {
    scrollbar-color: oklch(0.9 0 80) transparent;
  }
  @container theme style(--theme: dark) {
    :global(:root) :global(.docs-page) .sidebar {
      scrollbar-color: #4b5051 transparent;
    }
    :global(:root) .breadcrumb > span:nth-child(2) {
      color: var(--muted);
    }
  }
</style>
